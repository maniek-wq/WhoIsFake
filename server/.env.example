# Copy to .env and adjust. All values have sane dev defaults if omitted.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=dev-secret-change-me
# Optional: when set, the server uses Redis instead of the file-backed memory store.
# REDIS_URL=redis://localhost:6379
# Where the memory-store fallback persists durable data (users/friends).
DATA_FILE=./data/db.json
